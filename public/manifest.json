{
  "manifest_version": 3,
  "name": "X-Ray",
  "version": "0.1.0",
  "description": "AI-powered X-Ray summaries for webpages and documents.",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_page": "settings/index.html"
}